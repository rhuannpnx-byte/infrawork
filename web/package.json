{
  "name": "infrawork-web",
  "productName": "InfraWork",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "InfraWork — gestão de obras (web, whitelabel)",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && node mcp/build.mjs",
    "mcp:build": "node mcp/build.mjs",
    "mcp:build:local": "node mcp/build.mjs --modo=local",
    "preview": "vite preview",
    "typecheck": "npm run typecheck:apex && tsc --noEmit -p tsconfig.json",
    "lint": "eslint --cache .",
    "format": "prettier --write .",
    "seed:god": "node --env-file=.env supabase/seeds/seed-god.mjs",
    "db:reset": "supabase db reset",
    "test:apex": "vitest run -c vendor/apex/vitest.config.ts",
    "typecheck:apex": "tsc -p vendor/apex/tsconfig.json",
    "predev": "npm run typecheck:apex",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@supabase/supabase-js": "^2.106.1",
    "@tanstack/react-query": "^5.100.11",
    "@tanstack/react-router": "^1.170.7",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.25",
    "@tmcw/togeojson": "^7.1.2",
    "@turf/along": "^7.3.5",
    "@turf/bbox": "^7.3.5",
    "@turf/helpers": "^7.4.0",
    "@turf/length": "^7.3.5",
    "@xmldom/xmldom": "^0.8.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.2.1",
    "decimal.js": "^10.6.0",
    "exceljs": "^4.4.0",
    "exifr": "^7.1.3",
    "jszip": "^3.10.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.16.0",
    "pako": "^2.2.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-hotkeys-hook": "^5.3.2",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7",
    "supercluster": "^8.0.1",
    "tailwind-merge": "^3.6.0",
    "yet-another-react-lightbox": "^3.32.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.19.1",
    "@types/pako": "^2.0.4",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/supercluster": "^7.1.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.5.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "highs": "^1.15.3",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.15",
    "prettier": "^3.7.4",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",

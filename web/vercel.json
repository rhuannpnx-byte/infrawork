{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "ignoreCommand": "if [ -n \"$VERCEL_GIT_PREVIOUS_SHA\" ] && git cat-file -e \"$VERCEL_GIT_PREVIOUS_SHA^{commit}\" 2>/dev/null; then git diff --quiet \"$VERCEL_GIT_PREVIOUS_SHA\" HEAD -- .; else exit 1; fi",
  "rewrites": [
    {
      "source": "/oauth/registrar",
      "destination": "/api/mcp?oauth=registrar"
    },
    {
      "source": "/oauth/token",
      "destination": "/api/mcp?oauth=token"
    },
    {
      "source": "/.well-known/openid-configuration",
      "destination": "/api/mcp?wk=as"
    },
    {
      "source": "/.well-known/openid-configuration/:caminho*",
      "destination": "/api/mcp?wk=as"
    },
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/mcp?wk=prm"
    },
    {
      "source": "/.well-known/oauth-protected-resource/:caminho*",
      "destination": "/api/mcp?wk=prm"
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "/api/mcp?wk=as"
    },
    {
      "source": "/.well-known/oauth-authorization-server/:caminho*",
      "destination": "/api/mcp?wk=as"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https:; connect-src 'self' https://ysvcyfmcdlwfjeqzocpa.supabase.co wss://ysvcyfmcdlwfjeqzocpa.supabase.co https://server.arcgisonline.com https://services.arcgisonline.com; frame-src 'self' blob:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "functions": {
    "api/mcp.mjs": {
      "maxDuration": 300,
      "memory": 1769,
      "includeFiles": "mcp/dist/http.mjs"
    }
  }
}

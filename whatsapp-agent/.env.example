# Conexão com o Supabase do InfraWork (use a service_role key — o agente
# bypassa RLS para ler config e gravar fotos/status).
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# OpenRouter — chave da API para o modelo de visão.
OPENROUTER_API_KEY=sk-or-...
# Modelo de visão (precisa aceitar imagens). Default: Gemini Flash (barato).
OPENROUTER_MODEL=google/gemini-3.5-flash
# Modelo de texto do Oráculo (tool-calling). Default: usa OPENROUTER_MODEL.
# Pode apontar para um modelo mais forte de raciocínio.
OPENROUTER_MODEL_RAG=google/gemini-3.5-flash

# Bucket de Storage onde as fotos são salvas (mesmo do mobile/SIGA).
SUPABASE_BUCKET_FOTOS=monito-fotos

# Intervalos (ms)
POLL_CONFIG_MS=5000
DISCOVER_GROUPS_MS=300000

# Anti-ban: sync completo do histórico a cada conexão é um forte sinal de bot.
# Mantenha false no dia a dia; ligue temporariamente só quando for fazer backfill.
BAILEYS_SYNC_FULL_HISTORY=false

# Confiança mínima para aceitar a foto (0..1). Abaixo disso a foto é descartada
# (documentos, fotos ruins, correspondência fraca). Maior = só as melhores.
CONFIANCA_MINIMA=0.6

# Oráculo (RAG via DM)
ORACULO_MAX_FOTOS=10          # teto de fotos enviadas por pedido
ORACULO_CONVERSA_TTL_MIN=120  # min. de inatividade até re-triagem da obra
ORACULO_HISTORICO_MAX=10      # nº de trocas (pares) mantidas no contexto

# Nível de log do pino (trace|debug|info|warn|error)
LOG_LEVEL=info
